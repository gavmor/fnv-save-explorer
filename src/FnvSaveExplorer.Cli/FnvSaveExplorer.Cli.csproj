<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\FnvSaveExplorer.Core\FnvSaveExplorer.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Agent-tooling fix: an agent/user repeatedly invokes this CLI as separate OS processes
         (one invocation for `inventory`, another for `names`, ...); each pays full CLR/JIT
         cold-start with plain JIT. Native AOT compiles straight to a native executable, no JIT
         at runtime at all: verified zero AOT-compatibility warnings on publish (this project has
         no reflection/Reflection.Emit/dynamic-code dependency) and byte-identical `dump` output
         vs the plain-JIT build. Measured ~5.7x faster cold start on this host. Requires
         self-contained publish (`dotnet publish -r <rid>`); see docs:
         https://learn.microsoft.com/dotnet/core/deploying/native-aot -->
    <PublishAot>true</PublishAot>
  </PropertyGroup>

</Project>
